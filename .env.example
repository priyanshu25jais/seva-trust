# Copy this file to server/.env (or .env in the project root) and fill in your own values.
# Never commit the real file. Only names and fake placeholder values belong here.

NODE_ENV=development
PORT=4000

# MongoDB Atlas free cluster (transactions need a replica set; Atlas has one)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/seva-trust

# Long random text. In production the server refuses to start with a short or default value.
JWT_SECRET=change-me-to-a-long-random-string-of-24-or-more-characters
JWT_EXPIRES_IN=7d

# Placeholders for the demo. The brief gives no real trust details (assumption).
TRUST_NAME=Seva Trust
TRUST_NAME_HI=सेवा ट्रस्ट
TRUST_PAN=AAAAA0000A
TRUST_80G_NUMBER=PLACEHOLDER80G

CLIENT_ORIGIN=http://localhost:5173

# Shared secret for the mock payment-gateway webhook (POST /api/payments/mock/confirm)
MOCK_WEBHOOK_SECRET=change-me-webhook-secret

# AI Hindi summaries: gemini | groq | fallback (fallback = labelled template, no AI call)
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL=

# Per-IP limits per 15 minutes. Campaign events share one IP, so donate is generous.
RATE_LIMIT_DONATE_MAX=300
RATE_LIMIT_AUTH_MAX=30

# Serve the built React app from the API server (default true in production)
SERVE_CLIENT=false
